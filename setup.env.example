# Cuyum deployment settings

# Public domain used by Caddy.
# The domain must already point to the VPS public IP.
CUYUM_DOMAIN=cuyum.example.com

# Telegram channel or group ID.
# The bot token is stored separately in:
# secrets/telegram_bot_token.txt
TELEGRAM_CHAT_ID=-1000000000000

TELEGRAM_CHANNEL_USERNAME=@redcuyum
TELEGRAM_CHANNEL_URL=https://t.me/redcuyum


# Organismo competente y enlace a sus registros
COMPETENT_AUTHORITY_NAME=INPRES
COMPETENT_AUTHORITY_RECORDS_URL=http://contenidos.inpres.gob.ar/sismologia/xultimos

# Idioma global de las interfaces /web y /app
ENABLE_ENGLISH=false
